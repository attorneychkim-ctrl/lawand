{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "dek",
    "opening",
    "situation",
    "keyIssues",
    "calculation",
    "liquidationValueNote",
    "familyNote",
    "processExplanation",
    "outcome",
    "lawandNote",
    "differences",
    "tags"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 70
    },
    "dek": {
      "type": "string",
      "minLength": 30,
      "maxLength": 180
    },
    "opening": {
      "type": "string",
      "minLength": 30,
      "maxLength": 220
    },
    "situation": {
      "type": "string",
      "minLength": 80,
      "maxLength": 650
    },
    "keyIssues": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 4,
            "maxLength": 40
          },
          "body": {
            "type": "string",
            "minLength": 40,
            "maxLength": 280
          }
        }
      }
    },
    "calculation": {
      "type": "string",
      "minLength": 100,
      "maxLength": 700
    },
    "liquidationValueNote": {
      "type": "string",
      "minLength": 80,
      "maxLength": 520
    },
    "familyNote": {
      "type": "string",
      "minLength": 60,
      "maxLength": 420
    },
    "processExplanation": {
      "type": "string",
      "minLength": 80,
      "maxLength": 520
    },
    "outcome": {
      "type": "string",
      "minLength": 60,
      "maxLength": 420
    },
    "lawandNote": {
      "type": "string",
      "minLength": 40,
      "maxLength": 280
    },
    "differences": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 15,
        "maxLength": 180
      }
    },
    "tags": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 20
      }
    }
  }
}
